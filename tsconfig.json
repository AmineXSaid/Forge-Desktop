{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "types": ["node"],
    "paths": {
      "forge/*": ["../FORGE/src/*"]
    }
  },
  "include": ["host/**/*.ts"]
}
